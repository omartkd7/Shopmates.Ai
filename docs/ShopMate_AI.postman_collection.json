{
  "info": {
    "_postman_id": "shopmate-ai-postman-collection",
    "name": "ShopMate AI — API Collection",
    "description": "Collection complète de requêtes pour tester toutes les routes REST de l'API ShopMate AI (Santé, Authentification, Produits, Catégories, Commandes, Documents RAG, Agent IA).",
