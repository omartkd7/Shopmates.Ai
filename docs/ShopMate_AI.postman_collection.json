            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Huile d'Argan Pure 100ml (Édition Spéciale)\",\n  \"price\": 199.00,\n  \"stock\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
