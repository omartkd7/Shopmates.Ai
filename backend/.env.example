DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopmate
DB_USER=postgres
DB_PASSWORD=password
PORT=4000
# Comma-separated HTTPS origins for the mobile web build/admin app in production.
ALLOWED_ORIGINS=https://your-mobile-app.example.com
# Public API URL shown by Swagger after deployment.
PUBLIC_API_URL=https://your-api.example.com
MCP_SERVER_URL=http://localhost:4010/mcp
MCP_PORT=4010
# n8n calls are optional and never block an order. Use the Production webhook URL
# after activating backend/n8n/shopmate-manager-notifications.json in n8n.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/shopmate-manager-notifications
# Set the same value in the n8n webhook protection / reverse proxy. Do not commit it.
N8N_WEBHOOK_SECRET=
SEED_ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=15m

# ── RAG / Embeddings (OpenAI — DeepSeek has no embedding endpoint) ────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ── Chat Generation (DeepSeek) ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Provider-agnostic LLM (chat generation) ────────────────────────────────────
# Switch provider simply by setting these variables (zero code change required):
# OpenAI:    LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini  (LLM_BASE_URL optional)
# Claude:    LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=anthropic/claude-3.5-sonnet  LLM_API_KEY=sk-...
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com      LLM_MODEL=deepseek-chat                LLM_API_KEY=sk-...
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini





