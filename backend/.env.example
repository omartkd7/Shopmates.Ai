DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopmate
DB_USER=postgres
DB_PASSWORD=password
PORT=4000
SEED_ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=15m

# ── RAG / Embeddings (OpenAI — DeepSeek has no embedding endpoint) ────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ── Chat Generation (DeepSeek) ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Provider-agnostic LLM (chat generation) ────────────────────────────────────
# Switch provider by changing these 3 vars — no code change needed
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat





